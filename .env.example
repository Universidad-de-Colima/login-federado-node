# ================================
# Proyecto
# ================================
# Puerto publicado en el host. 4006 es el registrado en el IdP de UCOL: no cambiar.
APP_PORT=4006
PHPMYADMIN_PORT=8080

# ================================
# Base de datos (MySQL)
# ================================
DB_NAME=prueba
DB_USER=app
DB_PASS=secret
DB_ROOT_PASS=rootsecret
# true crea/actualiza las tablas solo (solo pruebas; en producción usar migraciones)
DB_SYNC=true

# ================================
# API (NestJS)
# ================================
API_PREFIX=prueba/api/v1
SESSION_SECRET=cambiar-en-produccion
# Adónde regresa el usuario tras autenticarse (ruta del SPA)
FRONT_URL=/prueba/

# ================================
# SAML (IdP de UCOL). No cambiar puerto, issuer ni certificados del demo.
# ================================
SAML_BASE_URL=http://localhost:4006/api/auth
SAML_ISSUER=http://localhost/20166932
SAML_ENTRY_POINT=https://wayf.ucol.mx/saml2/idp/SSOService.php
SAML_LOGOUT_URL=https://wayf.ucol.mx/saml2/idp/SingleLogoutService.php

# ================================
# Archivos (rutas DENTRO del contenedor, como en la plantilla)
# public_content se sirve en /prueba/public_content; private_content no se publica
# ================================
PUBLIC_CONTENT_PATH=/var/www/prueba/public_content
PRIVATE_CONTENT_PATH=/var/www/private_content
